<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- FTC index refresh at 23:00 and 05:00 local time, plus every 3 hours (YouTube cooldown resume) (America/New_York on the Mac mini; Tarun ruling 2026-09-13: two runs so a Team
       Update posted in the evening is indexed before school; the run lock skips an overlap). Set the Healthchecks.io check to
       a 1-day period with a 12-hour grace so either run keeps it green.
       Install: sed "s#__REPO__#$PWD#g; s#__HOME__#$HOME#g" launchd/me.uprobotics.ftc-index.plist.template \
                  > ~/Library/LaunchAgents/me.uprobotics.ftc-index.plist
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/me.uprobotics.ftc-index.plist -->
  <key>Label</key><string>me.uprobotics.ftc-index</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>__REPO__/ftc_index.py</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- Keep 05:00 / 23:00 for Team Updates before school; also every 3h so a YouTube
       block_cooldown_hours resume does not wait until the next calendar slot. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StartInterval</key><integer>10800</integer>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ftc-index/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ftc-index/launchd.err.log</string>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
